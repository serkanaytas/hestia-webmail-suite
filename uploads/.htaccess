# Disable script execution inside uploads directory
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
AddHandler default-handler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh .bat .exe .cmd
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi

<FilesMatch "\.(php|phtml|php[0-9]?|phar|pht|pgif|shtml|htaccess|pl|py|cgi|sh|bat|exe|cmd|vbs|scr|jar|jsp|asp|aspx|html|htm|svg)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; sandbox"
</IfModule>
